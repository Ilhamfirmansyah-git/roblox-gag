---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — Page Not Found | Brainrot Values"
  description="This page doesn't exist. Head back to the Steal a Brainrot value list."
>
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="text-8xl mb-6">🧠</div>
    <h1 class="text-4xl font-black text-white mb-3">404</h1>
    <p class="text-gray-400 text-lg mb-8">This page got stolen. It doesn't exist.</p>
    <a
      href="/"
      class="inline-block bg-purple-700 hover:bg-purple-600 text-white font-bold py-3 px-8 rounded-xl transition-colors"
    >
      Back to Value List
    </a>
  </div>
</BaseLayout>
