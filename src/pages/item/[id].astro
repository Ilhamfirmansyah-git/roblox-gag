---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RarityBadge } from '../../components/RarityBadge';
import { TrendIcon } from '../../components/TrendIcon';
import { AffiliateBanner } from '../../components/AffiliateBanner';
import items from '../../data/items.json';
import type { Item } from '../../types/item';

export function getStaticPaths() {
  return items.map(item => ({
    params: { id: item.id },
    props: { item }
  }));
}

const { item } = Astro.props as { item: Item };

function formatValue(n: number): string {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(2) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toString();
}

const trendText = item.trend === 'up' ? 'Rising' : item.trend === 'down' ? 'Falling' : 'Stable';
const trendColor = item.trend === 'up' ? 'text-green-400' : item.trend === 'down' ? 'text-red-400' : 'text-gray-400';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": `${item.name} Value — Steal a Brainrot`,
  "description": `Current value of ${item.name} in Steal a Brainrot is ${formatValue(item.value)}. Rarity: ${item.rarity}. Demand: ${item.demand}/10.`,
  "url": `https://stealbrainrot.com/item/${item.id}`,
  "mainEntity": {
    "@type": "Thing",
    "name": item.name,
    "description": `Steal a Brainrot item — ${item.rarity} rarity`
  }
};
---
<BaseLayout
  title={`${item.name} Value — Steal a Brainrot | Brainrot Values`}
  description={`${item.name} current value is ${formatValue(item.value)} in Steal a Brainrot. Rarity: ${item.rarity}. Demand: ${item.demand}/10. Is the trade fair? Check here.`}
  structuredData={structuredData}
>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <a href="/" class="text-purple-400 hover:text-purple-300 text-sm mb-6 inline-block">← Back to Value List</a>

    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 sm:p-8">
      <div class="flex items-start gap-6 mb-6">
        <img
          src={item.image}
          alt={item.name}
          class="w-24 h-24 rounded-xl object-cover bg-gray-800 flex-shrink-0"
          loading="eager"
          width="96"
          height="96"
          onerror="this.style.display='none'"
        />
        <div>
          <h1 class="text-2xl sm:text-3xl font-black text-white mb-2">{item.name}</h1>
          <RarityBadge rarity={item.rarity} />
          {!item.obtainable && (
            <span class="ml-2 text-xs bg-red-900 text-red-300 px-2 py-0.5 rounded">Unobtainable</span>
          )}
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-gray-800 rounded-xl p-4 text-center">
          <div class="text-2xl font-black text-yellow-400">{formatValue(item.value)}</div>
          <div class="text-xs text-gray-400 mt-1">Value</div>
        </div>
        <div class="bg-gray-800 rounded-xl p-4 text-center">
          <div class="text-2xl font-black text-white">{item.demand}<span class="text-gray-500 text-lg">/10</span></div>
          <div class="text-xs text-gray-400 mt-1">Demand</div>
        </div>
        <div class="bg-gray-800 rounded-xl p-4 text-center">
          <div class={`text-2xl font-black ${trendColor}`}>{item.trend === 'up' ? '↑' : item.trend === 'down' ? '↓' : '→'}</div>
          <div class="text-xs text-gray-400 mt-1">{trendText}</div>
        </div>
        <div class="bg-gray-800 rounded-xl p-4 text-center">
          <div class="text-2xl font-black text-white">{item.obtainable ? '✓' : '✗'}</div>
          <div class="text-xs text-gray-400 mt-1">{item.obtainable ? 'Obtainable' : 'Limited'}</div>
        </div>
      </div>

      <div class="bg-gray-800 rounded-xl p-4 mb-6">
        <h2 class="font-bold text-white mb-2">About {item.name}</h2>
        <p class="text-gray-300 text-sm">
          {item.name} is a <strong class="text-white">{item.rarity}</strong> item in Steal a Brainrot with a community value of <strong class="text-yellow-400">{formatValue(item.value)}</strong>.
          Demand is currently <strong class="text-white">{item.demand}/10</strong> and the market trend is <strong class={trendColor}>{trendText.toLowerCase()}</strong>.
          {!item.obtainable && <span> This item is <strong class="text-red-400">no longer obtainable</strong> in-game.</span>}
        </p>
        {item.notes && (
          <p class="text-gray-500 text-xs mt-3 italic">Note: {item.notes}</p>
        )}
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={`/calculator?add=${item.id}`}
          class="flex-1 bg-purple-700 hover:bg-purple-600 text-white text-center py-3 px-4 rounded-lg font-bold transition-colors"
        >
          Check in Trade Calculator
        </a>
        <a href="/" class="flex-1 bg-gray-800 hover:bg-gray-700 text-white text-center py-3 px-4 rounded-lg font-bold transition-colors">
          View All Items
        </a>
      </div>
    </div>

    <div class="mt-6">
      <AffiliateBanner client:load />
    </div>
  </div>
</BaseLayout>
