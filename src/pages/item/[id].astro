---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RarityBadge } from '../../components/RarityBadge';
import { TrendIcon } from '../../components/TrendIcon';
import { AffiliateBanner } from '../../components/AffiliateBanner';
import items from '../../data/items.json';
import type { Item } from '../../types/item';

export function getStaticPaths() {
  return items.map(item => ({
    params: { id: item.id },
    props: { item }
  }));
}

const { item } = Astro.props as { item: Item };

function formatValue(n: number): string {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(2) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
  return n.toLocaleString();
}

const trendText = item.trend === 'up' ? 'Rising' : item.trend === 'down' ? 'Falling' : 'Stable';
const trendColor = item.trend === 'up' ? 'text-green-400' : item.trend === 'down' ? 'text-red-400' : 'text-gray-400';
const trendBg = item.trend === 'up' ? 'bg-green-950 border-green-900' : item.trend === 'down' ? 'bg-red-950 border-red-900' : 'bg-gray-800 border-gray-700';

const rarityOrder: Record<string, number> = {
  Common: 0, Rare: 1, Epic: 2, Legendary: 3, Mythic: 4, Secret: 5, 'Brainrot God': 6
};
const relatedItems = (items as Item[])
  .filter(i => i.id !== item.id && i.rarity === item.rarity)
  .slice(0, 4);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "name": `${item.name} Value — Steal a Brainrot`,
  "description": `Current value of ${item.name} in Steal a Brainrot is ${formatValue(item.value)}. Rarity: ${item.rarity}. Demand: ${item.demand}/10.`,
  "url": `https://stealbrainrot.com/item/${item.id}`,
  "mainEntity": {
    "@type": "Thing",
    "name": item.name,
    "description": `Steal a Brainrot item — ${item.rarity} rarity. Value: ${formatValue(item.value)}.`
  }
};
---
<BaseLayout
  title={`${item.name} Value — Steal a Brainrot | Brainrot Values`}
  description={`${item.name} current value is ${formatValue(item.value)} in Steal a Brainrot. Rarity: ${item.rarity}. Demand: ${item.demand}/10. Is the trade fair? Check here.`}
  structuredData={structuredData}
>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <a href="/" class="inline-flex items-center gap-1.5 text-purple-400 hover:text-purple-300 text-sm mb-6 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Value List
    </a>

    <!-- Hero card -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden mb-6">
      <!-- Top section: image + name -->
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 p-6 sm:p-8">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl overflow-hidden bg-gray-800 flex-shrink-0 flex items-center justify-center shadow-xl ring-2 ring-gray-700">
          <img
            src={item.image}
            alt={item.name}
            class="w-full h-full object-contain"
            loading="eager"
            width="176"
            height="176"
            onerror="this.style.display='none'"
          />
        </div>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-3">
            <RarityBadge rarity={item.rarity} />
            {!item.obtainable && (
              <span class="text-xs bg-red-950 text-red-400 px-2 py-0.5 rounded border border-red-900">
                Unobtainable
              </span>
            )}
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white mb-4">{item.name}</h1>
          <div class="text-4xl font-black text-yellow-400 mb-1">{formatValue(item.value)}</div>
          <div class="text-sm text-gray-400">Community Value</div>
        </div>
      </div>

      <!-- Stats grid -->
      <div class="grid grid-cols-3 border-t border-gray-800">
        <div class="py-4 text-center border-r border-gray-800">
          <div class="flex items-center justify-center gap-0.5 mb-1">
            {Array.from({ length: 10 }).map((_, i) => (
              <div class={`w-1.5 h-4 rounded-sm ${i < item.demand ? 'bg-purple-500' : 'bg-gray-700'}`}></div>
            ))}
          </div>
          <div class="text-xs text-gray-400 mt-1">Demand {item.demand}/10</div>
        </div>
        <div class={`py-4 text-center border-r border-gray-800 ${trendBg} border-0`}>
          <div class={`text-2xl font-black ${trendColor}`}>
            {item.trend === 'up' ? '↑' : item.trend === 'down' ? '↓' : '→'}
          </div>
          <div class="text-xs text-gray-400 mt-1">{trendText}</div>
        </div>
        <div class="py-4 text-center">
          <div class="text-2xl font-black text-white">{item.obtainable ? '✓' : '✗'}</div>
          <div class="text-xs text-gray-400 mt-1">{item.obtainable ? 'Obtainable' : 'Limited'}</div>
        </div>
      </div>
    </div>

    <!-- About section -->
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 mb-6">
      <h2 class="font-bold text-white text-lg mb-3">About {item.name}</h2>
      <p class="text-gray-300 text-sm leading-relaxed mb-3">
        <strong class="text-white">{item.name}</strong> is a <strong class="text-white">{item.rarity}</strong> rarity
        item in Steal a Brainrot. The community consensus value is currently
        <strong class="text-yellow-400">{formatValue(item.value)}</strong>,
        with a demand rating of <strong class="text-white">{item.demand}/10</strong>.
        The market trend is currently <strong class={trendColor}>{trendText.toLowerCase()}</strong>.
        {!item.obtainable && (
          <span> Note: this item is <strong class="text-red-400">no longer obtainable</strong> through normal gameplay.</span>
        )}
      </p>
      {item.notes && (
        <p class="text-gray-500 text-xs italic border-t border-gray-800 pt-3">⚠️ {item.notes}</p>
      )}
    </div>

    <!-- Action buttons -->
    <div class="flex flex-col sm:flex-row gap-3 mb-6">
      <a
        href={`/calculator?add=${item.id}`}
        class="flex-1 bg-purple-700 hover:bg-purple-600 text-white text-center py-3.5 px-4 rounded-xl font-bold transition-colors"
      >
        🔢 Check in Trade Calculator
      </a>
      <a
        href={`/tierlist`}
        class="flex-1 bg-gray-800 hover:bg-gray-700 text-white text-center py-3.5 px-4 rounded-xl font-bold transition-colors"
      >
        📊 Add to Tier List
      </a>
    </div>

    <!-- Related items -->
    {relatedItems.length > 0 && (
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 mb-6">
        <h2 class="font-bold text-white text-base mb-4">More {item.rarity} Items</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {relatedItems.map(related => (
            <a href={`/item/${related.id}`} class="flex flex-col items-center gap-2 bg-gray-800 rounded-xl p-3 hover:bg-gray-700 transition-colors text-center group">
              <div class="w-16 h-16 rounded-lg overflow-hidden bg-gray-700 flex items-center justify-center group-hover:ring-2 ring-purple-600 transition-all">
                <img src={related.image} alt={related.name} class="w-16 h-16 object-contain" loading="lazy" width="64" height="64" onerror="this.style.display='none'" />
              </div>
              <span class="text-xs font-semibold text-white truncate w-full">{related.name}</span>
              <span class="text-xs text-yellow-400 font-bold">{formatValue(related.value)}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <AffiliateBanner client:load />
  </div>
</BaseLayout>
